# Secrets — never commit
.env
.env.local
.env.*.local

# Database and raw payloads — regenerated by the pipeline, never version-controlled
/data/

# Python
pipeline/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / Next.js
node_modules/
web/.next/
web/out/
web/next-env.d.ts
.turbo/

# Session tooling artefacts (auto-generated checkpoints, not project files)
SESSION-STATE.md
NOTES.md
# Handoff notes for resuming an agent session. Useful locally, but it restates
# what README.md and the commit history already record, so it is not carried in
# the repository where it would drift out of date.
HANDOFF.md
# Editor and agent launch configuration. Machine-local: the dev-server port and
# runtime here suit one workstation, not the project.
.claude/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
