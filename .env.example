# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit it.

# --- Paths ---------------------------------------------------------------
# SQLite database file. Relative paths are resolved from the repo root.
STOCKBOT_DB=data/stockbot.db

# Frozen configuration file.
STOCKBOT_CONFIG=config.frozen.json

# Root of the raw payload hierarchy written by the pipeline.
STOCKBOT_RAW_DIR=data/raw

# --- Runtime -------------------------------------------------------------
# All timestamps are stored in UTC. US/Eastern is used only for display and
# market-calendar logic. Do not change this.
STOCKBOT_STORAGE_TZ=UTC
STOCKBOT_DISPLAY_TZ=America/New_York

# --- Data source credentials --------------------------------------------
# No market data source is wired up yet (Phase 1 is skeleton only).
# Keys get added here as sources are integrated.
